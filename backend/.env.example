# ─── Servidor ───
NODE_ENV=development
PORT=5000
# Domínio(s) do FRONTEND (CORS + links dos e-mails). Vários separados por vírgula; o 1º vai nos e-mails.
# Em produção: obrigatoriamente https://
CLIENT_URL=http://localhost:5173
# Quantos proxies/balanceadores existem na frente da API (Render/Railway/Heroku = 1; Cloudflare + Nginx = 2)
TRUST_PROXY=1
# Redireciona http -> https (padrão: ligado em produção)
# ENFORCE_HTTPS=true

# ─── Banco ───
# Produção: MongoDB gerenciado (Atlas) com usuário de privilégio mínimo e acesso restrito por IP/VPC
MONGODB_URI=mongodb://localhost:27017/barbersync
MONGO_POOL_SIZE=20

# ─── Autenticação ───
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em produção o servidor NÃO sobe com segredo fraco (< 32 caracteres).
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
# Access token curto; a sessão se renova sozinha pelo cookie httpOnly (refresh token rotativo)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14

# ─── Cookies da sessão ───
# lax  = front e API no MESMO site (app.seudominio.com + api.seudominio.com)  ← recomendado
# none = sites diferentes (ex.: front na Vercel e API no Render sem domínio próprio). Exige HTTPS.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true        # padrão: true em produção
# COOKIE_DOMAIN=.seudominio.com

# ─── Rate limit ───
# memory = 1 instância da API. mongo = várias instâncias (contador compartilhado).
RATE_LIMIT_STORE=memory

# ─── E-mail transacional (SMTP) ───
# Funciona com Resend, Brevo, Mailgun, Amazon SES, Gmail (senha de app), etc.
# Se SMTP_HOST ficar vazio, os e-mails são apenas impressos no console (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BarberSync <no-reply@seudominio.com>"

# ─── Monitoramento / alertas ───
ALERT_EMAILS=voce@seudominio.com
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MIN=15
# Token para proteger /health/details (envie no header x-health-token)
HEALTH_TOKEN=
